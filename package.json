{
  "name": "organic-os",
  "version": "1.0.0",
  "description": "Organic OS - The Operating System for Being Human",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typescript": "5.3.3"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && python3 -m uvicorn main:app --reload",
    "build": "npm run build --workspace=apps/web",
    "build:all": "npm run build --workspace=apps/web && cd apps/api && python3 -m compileall .",
    "start": "cd apps/web && npm run start",
    "test": "npm run test --workspaces --if-present",
    "test:web": "cd apps/web && npm run test",
    "test:api": "cd apps/api && pytest",
    "lint": "npm run lint --workspaces --if-present",
    "lint:web": "cd apps/web && npm run lint",
    "lint:api": "cd apps/api && flake8 .",
    "typecheck": "cd apps/web && npx tsc --noEmit",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:migrate": "npm run db:migrate --workspace=packages/database",
    "db:seed": "npm run db:seed --workspace=packages/database",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "setup": "bash scripts/setup-full.sh",
    "deploy:vercel": "cd apps/web && npx vercel --prod",
    "deploy:docker": "docker-compose build && docker-compose push"
  },
  "keywords": [
    "organic-os",
    "personal-development",
    "wellness",
    "human-growth",
    "self-improvement"
  ],
  "author": "ALT Laboratories",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "python": ">=3.11"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
